@page "/"

@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-16 relative">
    
    <MudPaper Elevation="4" Class="pa-8 rounded-xl mb-6 welcome-banner" 
              Style="background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-secondary) 100%); color: white;">
        <MudGrid>
            <MudItem xs="12" md="8" Class="d-flex flex-column justify-center">
                <div class="d-flex align-center gap-4 mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Large" Style="color: rgba(255,255,255,0.8);" />
                    <MudText Typo="Typo.h3" Class="font-weight-bold" Style="color: white;">Система финансового учета</MudText>
                </div>
                <MudText Typo="Typo.h6" Class="mt-2 mb-6" Style="color: rgba(255,255,255,0.9); max-width: 650px; line-height: 1.4;">
                    Ваш центр управления операциями. Отслеживайте динамику поступлений, управляйте Журналом ПКО и актуализируйте справочники.
                </MudText>
                <div class="d-flex align-center gap-3">
                    <MudChip T="string" Style="background: rgba(255,255,255,0.15); color: white;" Variant="Variant.Text" Icon="@Icons.Material.Filled.CalendarToday" Label="true">
                        <b>@DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</b>
                    </MudChip>
                    <MudChip T="string" Style="background: rgba(255,255,255,0.15); color: white;" Variant="Variant.Text" Icon="@Icons.Material.Filled.VerifiedUser" Label="true">
                        Финансовый контролер
                    </MudChip>
                </div>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex justify-center justify-md-end relative overflow-hidden">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" 
                         Style="font-size: 11rem; color: rgba(255,255,255,0.12); position: absolute; right: -10px; bottom: -30px;" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Class="mb-6">
        @foreach (var metric in _kpiMetrics)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-5 rounded-xl elevation-3 kpi-card h-100" Style="@($"border-bottom: 4px solid {GetMetricColor(metric.Color)}!important")">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudAvatar Color="@metric.Color" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@metric.Icon" Size="Size.Small"/>
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-medium text-muted">@metric.Title</MudText>
                    </div>
                    <div class="d-flex flex-column align-end mt-4">
                        <MudText Typo="Typo.h4" Class="font-weight-black mb-1">@metric.Value</MudText>
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@(metric.IsIncrease ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)" 
                                     Size="Size.Small" 
                                     Color="@(metric.IsIncrease ? Color.Success : Color.Error)" />
                            <MudText Typo="Typo.caption" Class="font-weight-bold" Color="@(metric.IsIncrease ? Color.Success : Color.Error)">
                                @metric.Comparison
                            </MudText>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" lg="8">
            <MudPaper Class="pa-6 rounded-xl elevation-3 h-100 analytics-card d-flex flex-column">
                
                <div class="d-flex flex-wrap align-center justify-space-between gap-4 mb-6 pb-4" style="border-bottom: 1px solid var(--mud-palette-lines-default);">
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Динамика и структура</MudText>
                        <MudText Typo="Typo.body2" Class="text-muted">Анализ поступлений ПКО</MudText>
                    </div>
                    
                    <div class="d-flex align-center gap-3 flex-wrap">
                        <MudSelect T="int" Value="@_selectedDays" ValueChanged="OnDaysChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width: 140px; background-color: var(--mud-palette-background);">
                            <MudSelectItem Value="7">7 дней</MudSelectItem>
                            <MudSelectItem Value="14">14 дней</MudSelectItem>
                            <MudSelectItem Value="30">30 дней</MudSelectItem>
                        </MudSelect>
                        
                        <MudSelect T="string" Value="@_selectedCategory" ValueChanged="OnCategoryChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width: 200px; background-color: var(--mud-palette-background);">
                            <MudSelectItem Value="@("Все")">Все статьи</MudSelectItem>
                            <MudSelectItem Value="@("Оплата от покупателей")">От покупателей</MudSelectItem>
                            <MudSelectItem Value="@("Возврат аванса")">Возврат аванса</MudSelectItem>
                            <MudSelectItem Value="@("Взнос учредителя")">Взнос учредителя</MudSelectItem>
                        </MudSelect>
                    </div>
                </div>
                
                <div class="flex-grow-1 d-flex flex-column justify-center">
                    @if (_series.Any() && _series[0].Data.Count > 0)
                    {
                        <MudChart T="double" ChartType="ChartType.Line" 
                                  ChartSeries="@_series" 
                                  ChartLabels="@_xAxisLabels" 
                                  ChartOptions="@_options"
                                  Width="100%" 
                                  Height="280px"
                                  LegendPosition="Position.Bottom" />
                    }
                    else
                    {
                        <div class="d-flex flex-column justify-center align-center h-100 text-muted">
                            <MudIcon Icon="@Icons.Material.Filled.Snooze" Size="Size.Large" Class="mb-2"/>
                            <MudText>Нет данных</MudText>
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudPaper Class="pa-6 rounded-xl elevation-3 h-100 navigation-hub d-flex flex-column">
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-5">Быстрый доступ</MudText>
                
                <MudNavMenu Rounded="true" Color="Color.Primary" Class="pa-0 hub-menu flex-grow-1">
                    <MudNavLink Icon="@Icons.Material.Filled.Assignment" IconColor="Color.Primary"
                                OnClick='@(() => Nav.NavigateTo("/cash-receipt-orders"))'>
                        <div class="d-flex flex-column">
                            <MudText Typo="Typo.body1" Class="font-weight-bold">Журнал ПКО</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Реестр кассовых ордеров</MudText>
                        </div>
                    </MudNavLink>
                    
                    <MudNavLink Icon="@Icons.Material.Filled.AccountTree" IconColor="Color.Secondary"
                                OnClick='@(() => Nav.NavigateTo("/ifrs-accounts"))' Class="mt-2">
                        <div class="d-flex flex-column">
                            <MudText Typo="Typo.body1" Class="font-weight-bold">План счетов</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Настройка счетов МСФО</MudText>
                        </div>
                    </MudNavLink>

                    <MudNavLink Icon="@Icons.Material.Filled.AddChart" IconColor="Color.Info"
                                OnClick='@(() => Nav.NavigateTo("/income-articles"))' Class="mt-2">
                        <div class="d-flex flex-column">
                            <MudText Typo="Typo.body1" Class="font-weight-bold">Статьи доходов</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Классификатор поступлений</MudText>
                        </div>
                    </MudNavLink>

                    <MudNavLink Icon="@Icons.Material.Filled.LibraryBooks" IconColor="Color.Tertiary"
                                OnClick='@(() => Nav.NavigateTo("/reference-books"))' Class="mt-2">
                        <div class="d-flex flex-column">
                            <MudText Typo="Typo.body1" Class="font-weight-bold">Справочники</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Управление мастер-данными</MudText>
                        </div>
                    </MudNavLink>
                </MudNavMenu>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-6 rounded-xl elevation-3">
                <div class="d-flex align-center justify-space-between mb-4">
                    <div class="d-flex align-center gap-3">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Последние операции ПКО</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@_filteredOrders.Count найдено</MudChip>
                    </div>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick='@(() => Nav.NavigateTo("/cash-receipt-orders"))'>Весь журнал</MudButton>
                </div>
                <MudTable Items="@_filteredOrders.Take(5)" Dense="true" Hover="true" Elevation="0" Class="rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <HeaderContent>
                        <MudTh>Дата</MudTh>
                        <MudTh>Наименование операции</MudTh>
                        <MudTh>Сумма</MudTh>
                        <MudTh>Статус</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Date.ToString("dd.MM.yyyy HH:mm")</MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Name</MudText>
                        </MudTd>
                        <MudTd Class="font-weight-bold">@context.Amount.ToString("N0") TJS</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">
                                @GetStatusName(context.Status)
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <div class="d-flex align-center justify-space-between mt-8 pa-4 text-muted">
        <MudText Typo="Typo.caption">© 2026 Bookkeeping App — Финансовый контроль</MudText>
        <div class="d-flex gap-4">
            <MudText Typo="Typo.caption">Статус: <b>Online</b></MudText>
            <MudText Typo="Typo.caption">Версия: <b>1.3.2</b></MudText>
        </div>
    </div>

    @* <MudTooltip Text="Новый ПКО" Placement="Placement.Left">
        <MudFab Color="Color.Primary" 
                StartIcon="@Icons.Material.Filled.Add" 
                Size="Size.Large"
                Style="position: fixed; bottom: 32px; right: 32px; z-index: 100;"
                OnClick='@(() => Nav.NavigateTo("/cash-receipt-orders/create"))' />
    </MudTooltip> *@

</MudContainer>

<style>
    .kpi-card, .analytics-card, .navigation-hub { transition: all 0.2s ease-in-out; }
    .kpi-card:hover { transform: translateY(-3px); box-shadow: var(--mud-elevation-6)!important; }
    .hub-menu .mud-nav-link { border-radius: 8px; padding: 10px 14px; border: 1px solid transparent; margin-bottom: 4px; }
    .hub-menu .mud-nav-link:hover { background-color: var(--mud-palette-background-grey); border-color: var(--mud-palette-lines-default); }
    .text-muted { color: var(--mud-palette-text-secondary); }
    .analytics-card .mud-input-control { margin-top: 0 !important; }
</style>
