@page "/accounts"
@using Bookkeeping.Contracts.DTOs.Accounts5d.CategoryAccount5dDto
@using Bookkeeping.Contracts.DTOs.Accounts5d.IfrsAccountDto
@using Bookkeeping.Contracts.Enums
@using Bookkeeping.Contracts.Common.Responses
@inject HttpClient Http

<PageTitle>План счетов</PageTitle>

<MudText Typo="Typo.h5" Class="mb-6">План счетов (МСФО)</MudText>

<MudPaper Elevation="2" Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Поиск по номеру или названию..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search" 
                      IconSize="Size.Medium" 
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            Новый счет
        </MudButton>
    </MudStack>

    @if (_isLoading)
    {
        <div class="d-flex justify-center pa-10">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        @* Заголовок "таблицы" для дерева *@
        <div class="d-flex pa-2 mud-theme-primary mud-elevation-1 rounded-t px-4 py-2" style="font-weight: bold; color: white;">
            <div style="width: 150px;">Номер</div>
            <div style="flex: 1;">Наименование</div>
            <div style="width: 120px;" class="text-center">Тип</div>
            <div style="width: 100px;" class="text-end">Действия</div>
        </div>

        <MudTreeView T="TreeItemData" Items="_treeItems" MultiSelection="false" Hover="true" Dense="true">
            <ItemTemplate>
                <MudTreeViewItem T="TreeItemData" @bind-Expanded="@context.IsExpanded" Items="@context.Children" Value="@context">
                    <Content>
                        <div class="d-flex align-center flex-grow-1 py-1 pr-2">
                            @if (context.IsCategory)
                            {
                                <MudIcon Icon="@(context.IsExpanded ? Icons.Material.Filled.FolderOpen : Icons.Material.Filled.Folder)" 
                                         Color="Color.Info" Class="mr-2" Size="Size.Small" />
                                <MudText Typo="Typo.body1" Style="font-weight: 600;">@context.Name</MudText>
                            }
                            else
                            {
                                <div style="width: 150px;">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="font-family: monospace; font-weight: bold;">
                                        @context.AccountNumber
                                    </MudText>
                                </div>
                                <div style="flex: 1;">
                                    <MudText Typo="Typo.body2">@context.Name</MudText>
                                </div>
                                <div style="width: 120px;" class="d-flex justify-center">
                                    <MudChip T="string" Size="Size.Small" Color="@GetNatureColor(context.Nature)" Variant="Variant.Text">
                                        @context.Nature
                                    </MudChip>
                                </div>
                                <div style="width: 100px;" class="d-flex justify-end">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" />
                                </div>
                            }
                        </div>
                    </Content>
                </MudTreeViewItem>
            </ItemTemplate>
        </MudTreeView>
    }
</MudPaper>

<style>
    .mud-treeview-item-content {
        padding: 0 !important;
    }
    .mud-treeview-item-root {
        border-bottom: 1px solid var(--mud-palette-divider);
    }
</style>

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private HashSet<TreeItemData> _treeItems = new();

    // Вспомогательный класс для отображения в дереве
    public class TreeItemData
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string AccountNumber { get; set; } = "";
        public AccountNature? Nature { get; set; }
        public bool IsCategory { get; set; }
        public bool IsExpanded { get; set; }
        public HashSet<TreeItemData> Children { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var catTask = Http.GetFromJsonAsync<ApiResponse<List<CategoryAccount5dTreeDto>>>("api/v1/CategoryAccount5d/tree");
            var accTask = Http.GetFromJsonAsync<ApiResponse<List<IfrsAccountTreeDto>>>("api/v1/IfrsAccount/tree");

            await Task.WhenAll(catTask, accTask);

            var categories = (await catTask)?.Data ?? new();
            var accounts = (await accTask)?.Data ?? new();

            BuildUnifiedTree(categories, accounts);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BuildUnifiedTree(List<CategoryAccount5dTreeDto> categories, List<IfrsAccountTreeDto> accounts)
    {
        _treeItems.Clear();
        
        // Группируем ВСЕ счета по их категориям (включая вложенные счета)
        var allAccountsFlat = FlattenAccountTree(accounts);
        var accountsByCategory = allAccountsFlat
            .Where(a => a.ParentId == null) // Только корневые счета в рамках категории
            .GroupBy(a => a.CategoryAccountId)
            .ToDictionary(g => g.Key, g => g.ToList());

        foreach (var catDto in categories)
        {
            _treeItems.Add(MapCategoryToTreeItem(catDto, accountsByCategory));
        }
    }

    private TreeItemData MapCategoryToTreeItem(CategoryAccount5dTreeDto catDto, Dictionary<Guid, List<IfrsAccountTreeDto>> accountsMap)
    {
        var item = new TreeItemData
        {
            Id = catDto.Id,
            Name = catDto.Name,
            IsCategory = true,
            IsExpanded = true
        };

        // 1. Добавляем подкатегории
        foreach (var subCat in catDto.Children)
        {
            item.Children.Add(MapCategoryToTreeItem(subCat, accountsMap));
        }

        // 2. Добавляем корневые счета этой категории
        if (accountsMap.TryGetValue(catDto.Id, out var catAccounts))
        {
            foreach (var acc in catAccounts)
            {
                item.Children.Add(MapAccountToTreeItem(acc));
            }
        }

        return item;
    }

    private TreeItemData MapAccountToTreeItem(IfrsAccountTreeDto accDto)
    {
        var item = new TreeItemData
        {
            Id = accDto.Id,
            Name = accDto.AccountName,
            AccountNumber = accDto.AccountNumber,
            Nature = accDto.AccountNature,
            IsCategory = false
        };

        foreach (var subAcc in accDto.Children)
        {
            item.Children.Add(MapAccountToTreeItem(subAcc));
        }

        return item;
    }

    private List<IfrsAccountTreeDto> FlattenAccountTree(List<IfrsAccountTreeDto> nodes)
    {
        var list = new List<IfrsAccountTreeDto>();
        foreach (var node in nodes)
        {
            list.Add(node);
            if (node.Children.Any()) list.AddRange(FlattenAccountTree(node.Children));
        }
        return list;
    }

    private Color GetNatureColor(AccountNature? nature) => nature switch
    {
        AccountNature.Active => Color.Success,
        AccountNature.Passive => Color.Warning,
        _ => Color.Default
    };

    // Обертка ответа API (если не используется глобально)
    public class ApiResponse<T> { public T Data { get; set; } }
}
