@page "/reference-books"

@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6" Class="flex-grow-1">Справочники</MudText>
            <MudButton Href="/reference-books/categories/create" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" Size="Size.Small">
                Создать категорию
            </MudButton>
            <MudButton Href="/reference-books/create" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" Size="Size.Small">
                Создать справочник
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-2">
            <table class="mud-table mud-table-hover mud-table-striped" style="width:100%; border-collapse:collapse; font-size:0.9rem;">
                <thead class="mud-table-head">
                    <tr>
                        <th class="mud-table-cell" style="width: 250px; padding-left: 16px;">Название</th>
                        <th class="mud-table-cell">Описание</th>
                        <th class="mud-table-cell" style="width: 200px;">Счет (План счетов)</th>
                        <th class="mud-table-cell" style="width: 150px;">Записей</th>
                        <th class="mud-table-cell" style="width: 130px; text-align:right;">Действия</th>
                    </tr>
                </thead>
                <tbody class="mud-table-body">
                    @if (_treeNodes == null || !_treeNodes.Any())
                    {
                        <tr>
                            <td colspan="5" class="mud-table-cell text-center" style="padding: 16px;">Нет данных</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var node in _treeNodes)
                        {
                            @RenderNode(node, 0)
                        }
                    }
                </tbody>
            </table>
        </MudPaper>
    }
</MudContainer>

@code {
    private RenderFragment RenderNode(TreeNode node, int level) => __builder =>
    {
        var hasChildren = node.Children.Any();
        var isExpanded = _expandedNodes.Contains(node.Id);
        var isCategory = node.Type == NodeType.Category;

        <tr class="mud-table-row">
            <td class="mud-table-cell" style="padding: 8px 12px;">
                <div style="display: flex; align-items: center; padding-left: @(level * 24)px;">
                    @if (isCategory && hasChildren)
                    {
                        <MudIconButton Icon="@(isExpanded? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                       Size="Size.Small" Variant="Variant.Text"
                                       OnClick="@(() => ToggleNode(node.Id))" OnClickStopPropagation="true" Class="mr-1" />
                    }
                    else if (isCategory)
                    {
                        <span style="width: 32px; display:inline-block;"></span>
                    }

                    @if (isCategory)
                    {
                        <MudIcon Icon="@(isExpanded? Icons.Material.Filled.FolderOpen : Icons.Material.Filled.Folder)" Size="Size.Small" Class="mr-2 mud-text-secondary" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" Class="mr-2 mud-text-info" />
                    }

                    <MudText Typo="@(isCategory? Typo.body1: Typo.body2)" Class="@(isCategory ? "font-weight-bold" : "")">
                        @node.Name
                    </MudText>
                </div>
            </td>
            
            <td class="mud-table-cell">
                <MudText Typo="Typo.body2" Class="mud-text-secondary text-truncate" Style="max-width: 300px; display: block;">
                    @(string.IsNullOrEmpty(node.Description) ? "—" : node.Description)
                </MudText>
            </td>

            <td class="mud-table-cell">
                @if (node.AccountId.HasValue)
                {
                    <div class="d-flex align-center">
                        @if (_accountCache.TryGetValue(node.AccountId.Value, out var accountName))
                        {
                            <MudLink Typo="Typo.body2" Color="Color.Info" Underline="Underline.Hover"
                                     OnClick="@(() => Nav.NavigateTo($"/accounts/details/{node.AccountId}"))"
                                     Style="cursor: pointer; font-weight: 500;">
                                @accountName
                            </MudLink>
                            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="mud-text-primary ml-2" />
                        }
                        else
                        {
                            <MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" Style="width:12px; height:12px;" />
                        }
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-disabled">не привязан</MudText>
                }
            </td>

            <td class="mud-table-cell">
                @if (node.Type == NodeType.ReferenceBook)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                        @node.InfoItemsCount парам.
                    </MudChip>
                }
            </td>

            <td class="mud-table-cell" style="text-align:right; white-space:nowrap;">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => NavigateToDetail(node))" Title="Просмотр" />
                
                @if (node.Type == NodeType.ReferenceBook)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Inherit"
                                   Href="@($"/reference-books/edit/{node.Id}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   Href="@($"/reference-books/delete/{node.Id}")" />
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Inherit"
                                   Href="@($"/reference-books/categories/edit/{node.Id}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   Href="@($"/reference-books/categories/delete/{node.Id}")" />
                }
            </td>
        </tr>

        @if (hasChildren && isExpanded)
        {
            @foreach (var child in node.Children)
            {
                @RenderNode(child, level + 1)
            }
        }
    };
}
