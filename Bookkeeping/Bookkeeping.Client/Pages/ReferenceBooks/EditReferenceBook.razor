@page "/reference-books/edit/{Id:guid}"

@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Class="pa-8">
        <MudText Typo="Typo.h4" GutterBottom="true">Редактирование справочника</MudText>
        <MudText Typo="Typo.body2" Class="mb-6">Измените необходимые данные справочника.</MudText>
        
        @if (updateModel == null || categories == null)
        {
            <div class="d-flex justify-center pa-10">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <EditForm Model="@updateModel" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Название справочника"
                                      @bind-Value="updateModel.Name"
                                      For="@(() => updateModel.Name)"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      MaxLength="250" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?" Label="Категория" @bind-Value="updateModel.ReferenceBookCategoryId" Variant="Variant.Outlined" Clearable="true">
                            @foreach (var cat in categories)
                            {
                                <MudSelectItem T="Guid?" Value="@cat.Id">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Color="Color.Primary" />
                                        <MudText>@cat.Name</MudText>
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Описание" @bind-Value="updateModel.Description" Variant="Variant.Outlined" Lines="3" MaxLength="500" />
                    </MudItem>

                    @* Редактирование словаря Info *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mt-4 mb-2">Дополнительные параметры (Info)</MudText>
                        <MudDivider Class="mb-4" />
                        
                        @foreach (var item in _infoItems)
                        {
                            <MudGrid Spacing="2" Class="align-center mb-2">
                                <MudItem xs="5">
                                    <MudTextField Label="Ключ" @bind-Value="item.Key" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="5">
                                    <MudTextField Label="Значение" @bind-Value="item.Value" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="2" Class="d-flex justify-center">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveInfoItem(item))" />
                                </MudItem>
                            </MudGrid>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddInfoItem" Class="mt-2">
                            Добавить параметр
                        </MudButton>
                    </MudItem>

                    <MudItem xs="12" Class="d-flex justify-end gap-4 mt-4">
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Cancel">Отмена</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Сохранить</MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        }
    </MudPaper>
</MudContainer>
