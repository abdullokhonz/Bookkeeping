@page "/reference-books/categories/create"

@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Class="pa-8" Elevation="3">
        <MudText Typo="Typo.h4" GutterBottom="true">Новая категория справочников</MudText>
        <MudText Typo="Typo.body2" Class="mb-6">Создайте категорию для группировки справочников и привяжите её к МСФО счету.</MudText>

        @if (_ifrsAccounts == null)
        {
            <div class="d-flex justify-center pa-10">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <EditForm Model="@_category" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Название категории"
                                      @bind-Value="_category.Name"
                                      For="@(() => _category.Name)"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Placeholder="Например: Поставщики услуг" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?"
                                   Label="Связанный счет (ПС)"
                                   @bind-Value="_category.IfrsAccountId"
                                   For="@(() => _category.IfrsAccountId)"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Clearable="true"
                                   Placeholder="Выберите счет из списка">
                            @foreach (var acc in _ifrsAccounts)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)acc.Id)">
                                    <div class="d-flex align-center gap-2">
                                        <MudText Typo="Typo.body2" Color="Color.Primary" FontWeight="FontWeight.Bold">@acc.AccountNumber</MudText>
                                        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                                        <MudText Typo="Typo.body2">@acc.AccountName</MudText>
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Описание"
                                      @bind-Value="_category.Description"
                                      For="@(() => _category.Description)"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Placeholder="Краткое описание категории..." />
                    </MudItem>

                    <MudItem xs="12" Class="d-flex justify-end gap-4 mt-4">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   OnClick="Cancel">
                            Отмена
                        </MudButton>
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="_isProcessing">
                            @if (_isProcessing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Сохранение...</MudText>
                            }
                            else
                            {
                                <MudText>Создать категорию</MudText>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        }
    </MudPaper>
</MudContainer>
