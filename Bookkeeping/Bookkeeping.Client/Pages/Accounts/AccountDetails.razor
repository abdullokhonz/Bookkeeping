@page "/accounts/details/{Id:guid}"

@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-10">
    @* Хлебные крошки *@
    <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 mb-4" />

    @if (_account == null)
    {
        <div class="d-flex flex-column align-center justify-center" style="height: 40vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="mt-4 mud-text-secondary">Загрузка данных счета...</MudText>
        </div>
    }
    else
    {
        <MudPaper Elevation="4" Class="overflow-hidden rounded-lg">
            @* ШАПКА С ГРАДИЕНТОМ *@
            <div class="pa-8 d-flex align-start justify-space-between"
                 style="background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-info) 100%); color: white;">
                
                <div class="d-flex align-center gap-4">
                    <MudAvatar Color="Color.Secondary" Size="Size.Large" Elevation="2">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Medium" />
                    </MudAvatar>
                    <div>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h4" FontWeight="FontWeight.Bold">@_account.AccountNumber</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Color="Color.Surface"
                                           Size="Size.Small"
                                           OnClick="CopyAccountNumber"
                                           Title="Копировать номер" />
                        </div>
                        <MudText Typo="Typo.h6" Style="opacity: 0.9;">@_account.AccountName</MudText>
                    </div>
                </div>

                <MudChip T="string"
                         Color="@(_account.IsActive ? Color.Success : Color.Error)"
                         Icon="@(_account.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                         Size="Size.Large"
                         Variant="Variant.Filled"
                         Elevation="1">
                    @(_account.IsActive ? "Активен" : "Неактивен")
                </MudChip>
            </div>

            <div class="pa-8">
                <MudGrid Spacing="6">
                    @* ЛЕВАЯ КОЛОНКА *@
                    <MudItem xs="12" md="7">
                        <MudText Typo="Typo.h6" Class="mb-4 d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" />
                            Параметры счета
                        </MudText>
                        
                        <MudPaper Variant="Variant.Outlined" Class="pa-4 rounded-lg">
                            <div class="d-flex flex-column gap-4">
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Color="Color.Secondary">Категория:</MudText>
                                    <MudText FontWeight="FontWeight.Bold">@(_categoryName ?? "Не указана")</MudText>
                                </div>
                                <MudDivider />
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Color="Color.Secondary">Тип счета:</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                        @GetReadableNature(_account.AccountNature)
                                    </MudChip>
                                </div>
                            </div>
                        </MudPaper>

                        <MudText Typo="Typo.h6" Class="mt-8 mb-4 d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Notes" Color="Color.Primary" />
                            Описание
                        </MudText>
                        <MudPaper Variant="Variant.Outlined" Class="pa-4 rounded-lg mud-text-secondary">
                            @(string.IsNullOrWhiteSpace(_account.Description) ? "Описание отсутствует." : _account.Description)
                        </MudPaper>
                    </MudItem>

                    @* ПРАВАЯ КОЛОНКА *@
                    <MudItem xs="12" md="5">
                        <MudText Typo="Typo.h6" Class="mb-4 d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" />
                            История
                        </MudText>
                        <MudTimeline TimelinePosition="TimelinePosition.Start" Class="mb-6">
                            <MudTimelineItem Color="Color.Success" Size="Size.Small">
                                <MudText Typo="Typo.button">Создан</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@_account.CreatedAt.ToString("g")</MudText>
                            </MudTimelineItem>
                            @if (_account.UpdatedAt.HasValue)
                            {
                                <MudTimelineItem Color="Color.Info" Size="Size.Small">
                                    <MudText Typo="Typo.button">Изменен</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@_account.UpdatedAt.Value.ToString("g")</MudText>
                                </MudTimelineItem>
                            }
                        </MudTimeline>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-8" />

                @* ПАНЕЛЬ ДЕЙСТВИЙ *@
                <div class="d-flex justify-space-between align-center">
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoToMain">
                        Назад к списку
                    </MudButton>
                    <div class="d-flex gap-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit" OnClick="GoToEdit">
                            Изменить
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline" OnClick="GoToDelete">
                            Удалить
                        </MudButton>
                    </div>
                </div>
            </div>
        </MudPaper>
    }
</MudContainer>
