@page "/accounts/edit/{Id:guid}"

@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Class="pa-8">
        <MudText Typo="Typo.h4" GutterBottom="true">Редактирование счета</MudText>
        <MudText Typo="Typo.body2" Class="mb-6">Измените данные для редактирования счета.</MudText>
        
        @if (updateModel == null || categories == null)
        {
            <div class="d-flex justify-center pa-10">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <EditForm Model="@updateModel" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Номер счета"
                                      @bind-Value="updateModel.AccountNumber"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      HelperText="Номер счета нельзя менять" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField Label="Название счета"
                                      @bind-Value="updateModel.AccountName"
                                      For="@(() => updateModel.AccountName)"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?" Label="Категория" @bind-Value="updateModel.CategoryAccountId" Variant="Variant.Outlined" Clearable="true">
                            @foreach (var cat in categories)
                            {
                                <MudSelectItem T="Guid?" Value="@cat.Id">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Color="Color.Primary" />
                                        <MudText>@cat.Name</MudText>
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="AccountNature?" Label="Тип счета" @bind-Value="updateModel.AccountNature" Variant="Variant.Outlined" Clearable="true">
                            @foreach (AccountNature item in Enum.GetValues(typeof(AccountNature)))
                            {
                                <MudSelectItem T="AccountNature?" Value="@item">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Toc" Size="Size.Small" Color="Color.Primary" />
                                        <MudText>@GetReadableName(item)</MudText>
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Описание" @bind-Value="updateModel.Description" Variant="Variant.Outlined" Lines="3" />
                    </MudItem>

                    <MudItem xs="12" Class="d-flex justify-end gap-4">
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Cancel">Отмена</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Сохранить</MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        }
    </MudPaper>
</MudContainer>
