@page "/cash-receipt-orders/edit/{Id:guid}"

@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">
    <MudText Typo="Typo.h4" Class="mb-6 font-weight-bold">Редактирование ПКО</MudText>

    @if (_isLoadingData)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
    else if (_pkoModel == null)
    {
        <MudAlert Severity="Severity.Error">Не удалось загрузить данные документа.</MudAlert>
    }
    else
    {
        <EditForm Model="@_pkoModel" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudStack Spacing="4">
                        <MudCard Elevation="3">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">Основная информация</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudGrid>
                                    <MudItem xs="6">
                                        <MudTextField Label="Наименование"
                                                      @bind-Value="_pkoModel.Name"
                                                      For="@(() => _pkoModel.Name)"
                                                      Variant="Variant.Outlined"
                                                      Immediate="true" />
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudSelect T="DocumentStatus?"
                                                   Label="Статус"
                                                   @bind-Value="_pkoModel.Status"
                                                   For="@(() => _pkoModel.Status)"
                                                   Variant="Variant.Outlined"
                                                   AnchorOrigin="Origin.BottomCenter">
                                            @foreach (DocumentStatus item in Enum.GetValues(typeof(DocumentStatus)))
                                            {
                                                <MudSelectItem T="DocumentStatus?" Value="@item">
                                                    <div class="d-flex align-center gap-2">
                                                        <MudIcon Icon="@GetStatusIcon(item)" Color="@GetStatusColor(item)" Size="Size.Small" />
                                                        @GetStatusName(item)
                                                    </div>
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField Label="Описание"
                                                      @bind-Value="_pkoModel.Description"
                                                      For="@(() => _pkoModel.Description)"
                                                      Variant="Variant.Outlined"
                                                      Lines="3" />
                                    </MudItem>
                                </MudGrid>
                            </MudCardContent>
                        </MudCard>

                        <MudCard Elevation="3">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">Финансы и аналитика</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudGrid>
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField Label="Сумма"
                                                         @bind-Value="_pkoModel.Amount"
                                                         For="@(() => _pkoModel.Amount)"
                                                         Variant="Variant.Outlined"
                                                         Format="N2"
                                                         HideSpinButtons="true"
                                                         Adornment="Adornment.Start"
                                                         AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                                                         AdornmentColor="Color.Primary" />
                                    </MudItem>

                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="Guid?"
                                                   Label="Ставка НДС"
                                                   @bind-Value="_pkoModel.VatTaxId"
                                                   Variant="Variant.Outlined"
                                                   AnchorOrigin="Origin.BottomCenter"
                                                   Clearable="true"
                                                   Placeholder="Без НДС">
                                            @foreach (var vat in _vatTaxes)
                                            {
                                                <MudSelectItem T="Guid?" Value="@((Guid?)vat.Id)">
                                                    <div class="d-flex align-center gap-2">
                                                        <MudIcon Icon="@Icons.Material.Filled.Percent" Size="Size.Small" Color="Color.Primary" />
                                                        <MudText>@vat.VatRate%</MudText>
                                                    </div>
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="Guid?"
                                                   Label="Статья доходов"
                                                   @bind-Value="_pkoModel.IncomeCategoryId"
                                                   For="@(() => _pkoModel.IncomeCategoryId)"
                                                   Variant="Variant.Outlined"
                                                   AnchorOrigin="Origin.BottomCenter"
                                                   Clearable="true"
                                                   Placeholder="Выберите статью">
                                            @foreach (var category in _incomeCategories)
                                            {
                                                <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">
                                                    <div class="d-flex align-center gap-2">
                                                        <MudIcon Icon="@Icons.Material.Filled.AddChart" Size="Size.Small" Color="Color.Primary" />
                                                        <MudText>@category.Name</MudText>
                                                    </div>
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="Guid?"
                                                   Label="Контрагент"
                                                   @bind-Value="_pkoModel.ReferenceBookId"
                                                   For="@(() => _pkoModel.ReferenceBookId)"
                                                   Variant="Variant.Outlined"
                                                   AnchorOrigin="Origin.BottomCenter"
                                                   Clearable="true"
                                                   Placeholder="Выберите контрагента">
                                            @foreach (var refBook in _referenceBooks)
                                            {
                                                <MudSelectItem T="Guid?" Value="@((Guid?)refBook.Id)">
                                                    <div class="d-flex align-center gap-2">
                                                        <MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Small" Color="Color.Primary" />
                                                        <MudText>@refBook.Name</MudText>
                                                    </div>
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudCardContent>
                        </MudCard>
                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudStack Spacing="4">
                        <MudCard Elevation="3">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">Ответственные лица</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudTextField Label="Главный бухгалтер" @bind-Value="_pkoModel.Accountant" Variant="Variant.Outlined" Class="mb-4" />
                                <MudTextField Label="Кассир" @bind-Value="_pkoModel.Cashier" Variant="Variant.Outlined" />
                            </MudCardContent>
                        </MudCard>

                        <MudCard Elevation="3">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">Прикрепленный файл</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudFileUpload T="IBrowserFile"
                                               FilesChanged="OnFileSelected"
                                               Accept=".png, .jpg, .jpeg, .pdf">
                                    <CustomContent Context="fileUploadContext">
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                                   FullWidth="true"
                                                   OnClick="@fileUploadContext.OpenFilePickerAsync">
                                            @(_existingImage != null || _selectedFile != null ? "Заменить файл" : "Выбрать файл")
                                        </MudButton>
                                    </CustomContent>
                                    <SelectedTemplate Context="fileUploadContext">
                                    </SelectedTemplate>
                                </MudFileUpload>

                                @if (_existingImage != null || _selectedFile != null)
                                {
                                    <div class="mt-4 pa-4 rounded-lg" style="background-color: var(--mud-palette-background-grey); border: 1px solid var(--mud-palette-divider);">
                                        <div class="d-flex align-center justify-space-between mb-3 gap-2">
                                            <div class="d-flex align-center flex-grow-1 px-3 py-1 rounded-pill"
                                                 style="background-color: var(--mud-palette-secondary); color: white; max-width: 80%; min-height: 32px;">
                                                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Class="mr-2" />
                                                <MudText Typo="Typo.body2" Class="text-truncate font-weight-bold">
                                                    @(_selectedFile?.Name ?? _existingImage?.Name)
                                                </MudText>
                                            </div>

                                            <MudTooltip Text="Удалить файл">
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteForever"
                                                               Color="Color.Error"
                                                               Variant="Variant.Filled"
                                                               Size="Size.Small"
                                                               OnClick="RemoveFileAsync" />
                                            </MudTooltip>
                                        </div>

                                        <MudStack Spacing="2">
                                            <MudTextField Label="Название для базы"
                                                          @bind-Value="_imageUpdateModel.Name"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Dense="true" />
                                            <MudTextField Label="Описание файла"
                                                          @bind-Value="_imageUpdateModel.Description"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Lines="2"
                                                          Dense="true" />
                                        </MudStack>
                                    </div>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudStack>
                </MudItem>

                <MudItem xs="12" Class="d-flex justify-end gap-4 mt-2">
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/cash-receipt-orders"))">Отмена</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Disabled="_isProcessing">
                        @if (_isProcessing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <MudText>Сохранить изменения</MudText>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    }
</MudContainer>
