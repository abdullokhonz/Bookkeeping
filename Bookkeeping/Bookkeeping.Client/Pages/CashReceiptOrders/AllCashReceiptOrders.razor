@page "/cash-receipt-orders"

@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6" Class="flex-grow-1">Приходные кассовые ордера</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Small"
                       OnClick="@(() => Nav.NavigateTo("/cash-receipt-orders/create"))">
                Создать ПКО
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid Spacing="2" Class="d-flex align-center">
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="Искать по полю" @bind-Value="_searchField"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem Value="@("All")">Все поля</MudSelectItem>
                    <MudSelectItem Value="@("DocumentNumber")">№ Документа</MudSelectItem>
                    <MudSelectItem Value="@("OperationDate")">Дата (ДД.ММ.ГГГГ)</MudSelectItem>
                    <MudSelectItem Value="@("Amount")">Сумма</MudSelectItem>
                    <MudSelectItem Value="@("Status")">Статус</MudSelectItem>
                    <MudSelectItem Value="@("Vat")">НДС</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Введите текст для поиска..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true"
                              Immediate="true">
                </MudTextField>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ResetSearch"
                           FullWidth="true"
                           Style="height: 40px;">
                    Сброс
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="2" Class="pa-2">
        <MudTable Items="@_allOrders"
                  Filter="new Func<CashReceiptOrderGetDto, bool>(FilterFunc)"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Bordered="true"
                  Elevation="0"
                  Loading="_isLoading"
                  LoadingProgressColor="Color.Primary">
            
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<CashReceiptOrderGetDto, object>(x => ParseNumberForSorting(x.DocumentNumber))">
                        № Документа
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<CashReceiptOrderGetDto, object>(x => x.OperationDate)">
                        Дата
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<CashReceiptOrderGetDto, object>(x => GetStatusText(x.Status))">
                        Статус
                    </MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align: right;">
                    <MudTableSortLabel SortBy="new Func<CashReceiptOrderGetDto, object>(x => x.Amount)">
                        Сумма
                    </MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align: right;">
                    <MudTableSortLabel SortBy="new Func<CashReceiptOrderGetDto, object>(x => CalculateVatAmount(x.Amount, x.VatTaxId))">
                        НДС
                    </MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align: right;">Действия</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="№ Документа">
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@context.DocumentNumber</MudText>
                </MudTd>
                <MudTd DataLabel="Дата">
                    <MudText Typo="Typo.body2">@context.OperationDate.ToString("dd.MM.yyyy")</MudText>
                </MudTd>
                <MudTd DataLabel="Статус">
                    @switch (context.Status)
                    {
                        case DocumentStatus.Draft:
                            <MudChip T="string" Icon="@Icons.Material.Filled.EditNote" Color="Color.Warning" Size="Size.Small">Черновик</MudChip>
                            break;
                        case DocumentStatus.Processed:
                            <MudChip T="string" Icon="@Icons.Material.Filled.DoneAll" Color="Color.Success" Size="Size.Small">Проведен</MudChip>
                            break;
                        case DocumentStatus.Canceled:
                            <MudChip T="string" Icon="@Icons.Material.Filled.Block" Color="Color.Error" Size="Size.Small">Отменен</MudChip>
                            break;
                        default:
                            <MudText Typo="Typo.body2">@context.Status</MudText>
                            break;
                    }
                </MudTd>
                <MudTd DataLabel="Сумма" Style="text-align: right;">
                    <MudText Typo="Typo.body2" Color="Color.Success" Class="font-weight-bold">
                        @(context.Amount % 1 == 0 ? context.Amount.ToString("N0") : context.Amount.ToString("N2"))
                    </MudText>
                </MudTd>
                <MudTd DataLabel="НДС" Style="text-align: right;">
                    @if (context.VatTaxId.HasValue && _vatRates.TryGetValue(context.VatTaxId.Value, out var rate))
                    {
                        var vatAmount = context.Amount * (rate / 100m);
                        var formattedVat = vatAmount % 1 == 0 ? vatAmount.ToString("N0") : vatAmount.ToString("N2");
                        var formattedRate = rate % 1 == 0 ? rate.ToString("0") : rate.ToString("N2");
            
                        <MudText Typo="Typo.body2" Color="Color.Error" Class="font-weight-bold">
                            -@formattedVat
                            <MudText Typo="Typo.caption" Color="Color.Default" Class="ml-1">(@formattedRate%)</MudText>
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">Без НДС</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Действия" Style="text-align: right; white-space: nowrap;">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Nav.NavigateTo($"/cash-receipt-orders/details/{context.Id}"))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small" OnClick="@(() => Nav.NavigateTo($"/cash-receipt-orders/edit/{context.Id}"))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => Nav.NavigateTo($"/cash-receipt-orders/delete/{context.Id}"))" />
                </MudTd>
            </RowTemplate>

            <PagerContent>
                <MudTablePager InfoFormat="{first_item}-{last_item} из {all_items}" RowsPerPageString="Строк:" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>

            <NoRecordsContent>
                <MudText>Документы не найдены</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

<style>
    .mud-table-head .mud-table-cell {
        transition: color 0.3s ease;
        cursor: pointer;
    }

        .mud-table-head .mud-table-cell:hover {
            color: var(--mud-palette-primary) !important;
        }

    .mud-table-sort-label-icon {
        transition: transform 0.3s ease, opacity 0.2s ease, color 0.2s ease;
        opacity: 0;
    }

    .mud-table-cell:hover .mud-table-sort-label-icon {
        opacity: 0.4;
    }

    .mud-table-sort-label-icon.mud-direction-asc,
    .mud-table-sort-label-icon.mud-direction-desc {
        opacity: 1 !important;
        color: var(--mud-palette-primary) !important;
    }
</style>
