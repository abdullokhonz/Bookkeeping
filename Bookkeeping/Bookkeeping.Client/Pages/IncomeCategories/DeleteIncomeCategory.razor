@page "/income-categories/delete/{Id:guid}"

@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudPaper Elevation="4" Class="pa-0 overflow-hidden">
        <div style="height: 6px;" class="mud-bg-error"></div>
        
        <div class="pa-8">
            <div class="d-flex align-center mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Large" Class="mr-3" />
                <MudText Typo="Typo.h5" FontWeight="FontWeight.Bold">Удаление статьи</MudText>
            </div>

            @if (_model == null)
            {
                <div class="d-flex flex-column align-center pa-10">
                    <MudProgressCircular Color="Color.Error" Indeterminate="true" Class="mb-2" />
                    <MudText Typo="Typo.caption">Загрузка данных...</MudText>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body1" Class="mb-6">
                    Вы собираетесь безвозвратно удалить статью доходов.
                </MudText>

                <MudPaper Variant="Variant.Outlined" Class="pa-4 mb-6 mud-bg-gray-default">
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Название:</MudText>
                            <MudText Typo="Typo.body2" FontWeight="FontWeight.Bold">@_model.Name</MudText>
                        </div>
                        <MudDivider />
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Привязанный счет:</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Primary">
                                @(_linkedAccountName ?? "Загрузка...")
                            </MudText>
                        </div>
                    </div>
                </MudPaper>

                <MudAlert Severity="Severity.Error" Variant="Variant.Text" Class="mb-6 pa-2">
                    Внимание: Статья будет удалена из базы данных окончательно.
                </MudAlert>

                <div class="d-flex justify-space-between align-center">
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="Cancel">
                        Назад
                    </MudButton>
                    
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteForever"
                               OnClick="HandleDelete"
                               Disabled="_isProcessing">
                        @if (_isProcessing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <MudText>Удалить навсегда</MudText>
                        }
                    </MudButton>
                </div>
            }
        </div>
    </MudPaper>
</MudContainer>
