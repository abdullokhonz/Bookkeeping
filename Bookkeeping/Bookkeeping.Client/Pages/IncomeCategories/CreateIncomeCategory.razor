@page "/income-categories/create"

@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Class="pa-8" Elevation="3">
        <MudText Typo="Typo.h4" GutterBottom="true">Новая статья доходов</MudText>
        <MudText Typo="Typo.body2" Class="mb-6">Заполните данные для классификации входящих денежных потоков.</MudText>

        <EditForm Model="@_model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Название статьи"
                                  @bind-Value="_model.Name"
                                  For="@(() => _model.Name)"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Placeholder="Например: Выручка от реализации" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="Guid?"
                               Label="Связанный счет (ПС)"
                               @bind-Value="_model.IfrsAccountId"
                               For="@(() => _model.IfrsAccountId)"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter"
                               Clearable="true"
                               Placeholder="Выберите счет из списка">

                        <MudSelectItem T="Guid?" Class="sticky-action-item pa-0">
                            <div @onclick="CreateAccount" class="d-flex align-center gap-2 pa-3 cursor-pointer action-content">
                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" />
                                <MudText Color="Color.Primary"><b>Создать счёт</b></MudText>
                            </div>
                        </MudSelectItem>

                        @if (_accounts == null)
                        {
                            <MudSelectItem T="Guid?" Value="null" Disabled="true">Загрузка счетов...</MudSelectItem>
                        }
                        else
                        {
                            @foreach (var acc in _accounts)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)acc.Id)">
                                    <div class="d-flex align-center gap-2">
                                        <MudText Typo="Typo.body2" Color="Color.Primary" FontWeight="FontWeight.Bold">@acc.AccountNumber</MudText>
                                        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                                        <MudText Typo="Typo.body2">@acc.AccountName</MudText>
                                    </div>
                                </MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Описание статьи"
                                  @bind-Value="_model.Description"
                                  For="@(() => _model.Description)"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Placeholder="Укажите назначение данной статьи доходов..." />
                </MudItem>

                <MudItem xs="12" Class="d-flex justify-end gap-4 mt-4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               OnClick="Cancel">
                        Отмена
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="_isProcessing">
                        @if (_isProcessing)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Сохранение...</MudText>
                        }
                        else
                        {
                            <MudText>Сохранить статью</MudText>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>
</MudContainer>

<style>
    .sticky-action-item {
        position: sticky !important;
        top: 0;
        z-index: 10;
        background-color: var(--mud-palette-surface) !important;
        border-bottom: 1px solid var(--mud-palette-divider);
    }

    .action-content {
        width: 100%;
        user-select: none;
    }

        .action-content:hover {
            background-color: var(--mud-palette-action-default-hover);
        }

    .cursor-pointer {
        cursor: pointer;
    }
</style>
