@page "/confirm-code"
@using Bookkeeping.Contracts.DTOs.Auth
@layout EmptyLayout
@attribute [AllowAnonymous]

@inject HttpClient Http
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small"
              Class="d-flex align-center justify-center"
              Style="min-height: 100dvh; padding: 16px;">
    <MudPaper Elevation="4" Class="pa-8 mud-width-full" Style="max-width:400px; text-align:center; border-radius: 12px;">
        <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Primary" Size="Size.Large" Class="mb-4" />
        
        <MudText Typo="Typo.h5" Class="mb-2">Подтверждение доступа</MudText>
        <MudText Typo="Typo.body2" Class="mb-6">
            Введите проверочный код, отправленный на <br />
            <b>@Identifier</b>
        </MudText>

        <MudForm @ref="_form">
            <MudTextField @bind-Value="_model.Code"
                          Label="Код подтверждения"
                          Variant="Variant.Outlined"
                          MaxLength="6"
                          Class="mb-6"
                          HelperText="Введите 6 цифр из сообщения"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Numbers" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="VerifyCode"
                       Disabled="@(string.IsNullOrWhiteSpace(_model.Code) || _isLoading)">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-n1" />
                    <MudText Class="ms-2">Проверка...</MudText>
                }
                else
                {
                    <MudText>Подтвердить</MudText>
                }
            </MudButton>
        </MudForm>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.body2">
            Не получили код? <MudLink Typo="Typo.body2" OnClick="ResendCode" Style="cursor:pointer">Отправить повторно</MudLink>
        </MudText>
        
        <MudLink href="/login" Typo="Typo.body2" Class="d-block mt-4">Вернуться ко входу</MudLink>
    </MudPaper>
</MudContainer>
