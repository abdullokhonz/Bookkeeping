@page "/register"

@layout EmptyLayout

@attribute [AllowAnonymous]

@inject HttpClient Http
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small"
              Class="d-flex align-center justify-center"
              Style="min-height: 100dvh; padding: 16px;">
    <MudPaper Elevation="4" Class="pa-8 mud-width-full" Style="max-width:550px; border-radius: 12px;">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">Регистрация</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6">Создайте аккаунт для работы в системе</MudText>

        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Username" Label="Никнейм"
                                  Variant="Variant.Outlined" Required="true"
                                  For="@(() => _model.Username)"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.FirstName" Label="Имя"
                                  Variant="Variant.Outlined" Required="true"
                                  For="@(() => _model.FirstName)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.LastName" Label="Фамилия"
                                  Variant="Variant.Outlined" Required="true"
                                  For="@(() => _model.LastName)" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_contactInput"
                                  Label="Email или Номер телефона"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  HelperText="Введите вашу почту или телефон с кодом страны (+...)"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.ContactMail" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Password"
                                  Label="Пароль"
                                  InputType="@_passwordInput"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  For="@(() => _model.Password)"
                                  Adornment="Adornment.End"
                                  OnAdornmentClick="@TogglePasswordVisibility"
                                  AdornmentIcon="@_passwordInputIcon" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.ConfirmPassword" Label="Подтверждение"
                                  InputType="@_passwordInput" Variant="Variant.Outlined" Required="true"
                                  For="@(() => _model.ConfirmPassword)" />
                </MudItem>

                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_model.IsPersonalDataAccepted"
                                 Label="Согласен на обработку персональных данных"
                                 Color="Color.Primary" />
                </MudItem>

                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                               Disabled="@(!_isValid || _isLoading || !_model.IsPersonalDataAccepted)"
                               OnClick="SubmitRegister" Class="mt-4">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-n1" />
                            <MudText Class="ms-2">Регистрация...</MudText>
                        }
                        else
                        {
                            <MudText>Создать аккаунт</MudText>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>

        <MudText Align="Align.Center" Class="mt-6">
            Уже зарегистрированы? <MudLink href="/login">Войти</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>
